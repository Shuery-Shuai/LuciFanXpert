# ShellCheck 严格模式配置（本项目）
# 由 CI/CD 流水线的语法检查阶段引入；目的是让「严格检查」可复现，
# 同时把经确认属于误报/有意为之的规则在配置层集中抑制，避免到处撒行级 disable。

enable=all

# ── 以下规则经逐条确认后抑制，理由写在下面，勿轻易放开 ──────────────────

# SC2250：要求所有变量都写 ${var}。本项目大量整数运算与字符串拼接用裸 $var，
# 风格统一、可读性更好；批量改写 950 处有引入运算错误的风险，收益为零。
disable=SC2250

# SC2310 / SC2312：函数或命令替换放在 &&/|| 条件中会“掩盖返回值”。
# 本项目的错误处理就是刻意依赖这一行为：失败即 die/return，返回值不参与后续判断。
disable=SC2310
disable=SC2312

# SC2249：要求每个 case 都有 *) 分支。本项目惯用「单分支 case 做类型守卫」，
# 形如 case "$x" in ''|*[!0-9]*) x=0 ;; esac —— 隐式 default 就是“合法值继续处理”，
# 补一个空 *) 只是噪声。真正需要默认分支的场景（log_msg 级别、预设曲线恢复、
# 校准进度 stage）已在代码中显式补齐。
disable=SC2249
