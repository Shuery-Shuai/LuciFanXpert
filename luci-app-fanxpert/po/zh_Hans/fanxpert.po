msgstr "当前没有进行中的校准"

msgid "PWM controller not found"
msgstr "未找到 PWM 控制器"

msgid "State file not found"
msgstr "未找到状态文件"

msgid "Service is running. Please stop it first."
msgstr "服务正在运行，请先停止服务再校准。"

msgid "Calibration started in background"
msgstr "校准已在后台开始"

msgid "Curve Type"
msgstr "曲线类型"

msgid "Linear"
msgstr "线性"

msgid "Stepped (%d levels)"
msgstr "阶梯（%d 档）"

msgid "Step Levels"
msgstr "阶梯档数"

msgid "3 levels"
msgstr "3 档"

msgid "4 levels"
msgstr "4 档"

msgid "5 levels (default)"
msgstr "5 档（默认）"

msgid "6 levels"
msgstr "6 档"

msgid "8 levels"
msgstr "8 档"

msgid "10 levels"
msgstr "10 档"

msgid "12 levels"
msgstr "12 档"

msgid "Only used by the stepped curve: the temperature range is split into this many steps."
msgstr "仅阶梯曲线使用：温度区间被等分成这么多档。"

msgid "Bezier (Smooth)"
msgstr "贝塞尔（平滑）"

msgid "Bezier/Linear/Stepped use the temperature range below; Fixed Speed ignores temperature and just holds the start speed."
msgstr "贝塞尔 / 线性 / 阶梯使用下方的温度区间；固定转速忽略温度，只保持起始转速。"
