config global 'settings'
	option enabled '0'
	option log_level 'info'

config curve 'silent'
	option type 'bezier'
	option sensor 'cpu_temp'
	option temp_min '40'
	option temp_max '70'
	option pwm_start '20'
	option pwm_end '70'

config curve 'standard'
	option type 'bezier'
	option sensor 'cpu_temp'
	option temp_min '35'
	option temp_max '75'
	option pwm_start '30'
	option pwm_end '100'

config curve 'performance'
	option type 'bezier'
	option sensor 'cpu_temp'
	option temp_min '30'
	option temp_max '65'
	option pwm_start '40'
	option pwm_end '100'

config curve 'fixed'
	option type 'fixed'
	option sensor 'cpu_temp'
	option pwm_start '50'

config curve 'full_speed'
	option type 'bezier'
	option sensor 'cpu_temp'
	option temp_min '0'
	option temp_max '100'
	option pwm_start '100'
	option pwm_end '100'

config sensor 'cpu_temp'
	option type 'hwmon'
	option platform 'auto'
	option label 'CPU Temperature'

config fan 'cpu_fan'
	list sensors 'cpu_temp'
	option enabled '1'
	option label 'CPU Fan'
	option curve 'standard'
	option pwm_path 'auto'
	option pwm_min_start '0'
	option pwm_min_start_source 'unknown'
	option pwm_min_start_timestamp '0'
	option never_stop '1'
	option quiet_mode '0'
	option auto_stop '0'
	option ramp_up_time '30'
	option ramp_down_time '120'
