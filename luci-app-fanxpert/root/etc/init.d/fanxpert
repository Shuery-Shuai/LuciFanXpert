#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/fanxpert.sh

start_service() {
	# 始终启动守护进程，由守护进程自身处理配置生成和启用检查
	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 60 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	"$PROG" reload
	logger -t FANXPERT "配置已重载"
}

service_triggers() {
	procd_add_reload_trigger "fanxpert"
}
